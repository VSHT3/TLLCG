{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"paths": {
			"@data/*": ["../data/*"],
			"@engine/*": ["./src/engine/*"]
		},
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noFallthroughCasesInSwitch": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"types": ["vite/client"]
	},
	"include": ["src", "test"]
}
